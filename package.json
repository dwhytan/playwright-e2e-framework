{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "description": "QA Automation Portfolio — PeruRail UI testing with Playwright + TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "report:html": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "ai:triage": "tsx ai/triage.ts",
    "ai:ask": "tsx ai/ask.ts",
    "ai:i18n": "tsx ai/i18n.ts"
  },
  "keywords": [],
  "author": "Davis Huaytán",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.8",
    "tsx": "^4.23.15"
  }
}
